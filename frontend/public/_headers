# Cloudflare Pages — HTTP response headers
# Applied at the CDN edge for every matching path.
#
# Reference: https://developers.cloudflare.com/pages/configuration/headers/

# ─── Security headers — applied to all responses ───────────────────────────
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=()
  # unsafe-none is required for Google Identity Services (GIS):
  # Google's GIS iframe and OAuth popups send postMessage back to the main window.
  # same-origin or same-origin-allow-popups cause Chrome to block postMessage from accounts.google.com.
  Cross-Origin-Opener-Policy: unsafe-none
# ─── Immutable cache for Vite content-hashed assets ─────────────────────────
# Vite writes chunk filenames with a content hash (e.g. vendor-react-abc123.js).
# The hash changes on every rebuild, so the filename is a permanent, unique URL.
# max-age=31536000 (1 year) + immutable tells browsers to never revalidate —
# a repeat visitor fetches zero bytes of JS/CSS until the next deploy.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# ─── index.html — must never be cached ──────────────────────────────────────
# index.html is the entry point that references the current hashed chunk filenames.
# If cached, a returning user loads stale chunk references after a deploy.
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
