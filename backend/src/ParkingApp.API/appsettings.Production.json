{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System": "Warning"
    },
    "Serilog": {
      "MinimumLevel": "Information"
    },
    "File": {
      "Enabled": false,
      "RetainedFileCountLimit": 5
    },
    "Performance": {
      "SlowRequestMs": 200
    }
  },
  "Outbox": {
    "PollIntervalSeconds": 15,
    "BusyPollIntervalSeconds": 5,
    "EmptyBackoffMaxSeconds": 60,
    "BatchSize": 50
  },
  "Marketplace": {
    "Search": {
      "MaxPageSize": 40,
      "CacheMinutes": 5
    },
    "Map": {
      "MaxPins": 500,
      "CacheMinutes": 5
    }
  },
  "Forecast": {
    "Enabled": false,
    "EnableMl": false,
    "MaxHorizonHours": 24,
    "MinIntervalMinutes": 60,
    "SingleCacheMinutes": 5,
    "OwnerCacheMinutes": 3,
    "ModelCacheHours": 12
  },
  "Routing": {
    "UseOsrmOnSearch": true
  },
  "SignalR": {
    "KeepAliveSeconds": 30,
    "ClientTimeoutSeconds": 60
  },
  "Media": {
    "EnableRuntimeResize": false,
    "MaxRuntimeResizeDimension": 800,
    "GenerateUploadThumbnail": false,
    "UploadThumbnailMaxWidth": 400
  },
  "Corporate": {
    "WaitlistAutoPromotion": {
      "Enabled": true,
      "PollIntervalSeconds": 90,
      "BatchSize": 25
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "https://parkeaseapp.runasp.net",
      "http://parkeaseapp.runasp.net"
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "SET_VIA_USER_SECRETS_OR_ENV_VAR",
    "Redis": "SET_VIA_USER_SECRETS_OR_ENV_VAR"
  },
  "Redis": {
    "InstanceName": "ParkEase_Prod_",
    "DefaultTtlMinutes": 15,
    "MaxTtlMinutes": 60,
    "CompressionThresholdBytes": 256,
    "ConnectTimeoutMs": 5000,
    "SyncTimeoutMs": 5000,
    "AsyncTimeoutMs": 5000,
    "ConnectRetry": 3,
    "KeepAliveSeconds": 60,
    "VersionedNamespaces": [ "search", "map", "parking-forecast", "owner-parking-forecast" ]
  },
  "Jwt": {
    "SecretKey": "SET_VIA_USER_SECRETS_OR_ENV_VAR"
  },
  "Storage": {
    "Provider": "R2",
    "R2": {
      "AccountId": "SET_VIA_USER_SECRETS_OR_ENV_VAR",
      "AccessKey": "SET_VIA_USER_SECRETS_OR_ENV_VAR",
      "SecretKey": "SET_VIA_USER_SECRETS_OR_ENV_VAR",
      "BucketName": "SET_VIA_USER_SECRETS_OR_ENV_VAR",
      "PublicUrl": "SET_VIA_USER_SECRETS_OR_ENV_VAR"
    }
  },
  "Stripe": {
    "SecretKey": "SET_VIA_USER_SECRETS_OR_ENV_VAR",
    "PublishableKey": "SET_VIA_USER_SECRETS_OR_ENV_VAR"
  },
  "Resend": {
    "ApiKey": "SET_VIA_USER_SECRETS_OR_ENV_VAR",
    "FromEmail": "onboarding@resend.dev"
  },
  "Firebase": {
    "ProjectId": "SET_VIA_USER_SECRETS_OR_ENV_VAR",
    "PrivateKeyId": "SET_VIA_USER_SECRETS_OR_ENV_VAR",
    "PrivateKey": "SET_VIA_USER_SECRETS_OR_ENV_VAR",
    "ClientEmail": "SET_VIA_USER_SECRETS_OR_ENV_VAR",
    "ClientId": "SET_VIA_USER_SECRETS_OR_ENV_VAR",
    "ClientX509CertUrl": "SET_VIA_USER_SECRETS_OR_ENV_VAR"
  },
  "ChannelIsolation": {
    "Enabled": true,
    "TreatMissingClaimAs": "Marketplace",
    "EnforceCompanyClaimMatch": true,
    "VendorAllocationAllowlistEnabled": true
  }
}
